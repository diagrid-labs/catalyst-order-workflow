### Get the current inventory
GET http://localhost:3002/api/v1/inventory

### Delete the current inventory
DELETE http://localhost:3002/api/v1/inventory

### Restock inventory
POST http://localhost:3002/api/v1/inventory/restock

### Submit a simple order
// @name wfrequest
POST http://localhost:3006/orders
Content-Type: application/json

{"customer": "kendall", "item": "orange", "total": 100}

### Submit an expensive order
// @name wfrequest_approval
POST http://localhost:3006/orders
Content-Type: application/json

{"customer": "Veronica", "item": "kiwi", "total": 1299.00}

### Get the status of an order
@instance_id = {{wfrequest.response.body.instance_id}}

GET http://localhost:3006/orders/{{instance_id}}

### Approve an order
@instance_id = {{wfrequest_approval.response.body.instance_id}}

POST http://localhost:3006/orders/{{instance_id}}/approve
Content-Type: application/json

{"approver": "kendall", "approved": true}

### Place a reposition order directly (bypasses the agent)
POST http://localhost:3002/api/v1/inventory/orders
Content-Type: application/json

{"items": {"orange": 10, "apple": 5}}

### List active (in-flight) reposition orders
GET http://localhost:3002/api/v1/inventory/orders/active

### Confirm delivery as ordered (no amendments)
POST http://localhost:3002/api/v1/inventory/orders/reposition_REPLACEME/confirm
Content-Type: application/json

{"message": "Truck arrived, contents match the order"}

### Confirm delivery with amended quantities
POST http://localhost:3002/api/v1/inventory/orders/reposition_REPLACEME/confirm
Content-Type: application/json

{
  "message": "Short on apple, extra orange",
  "amendments": {"orange": 12, "apple": 3}
}

### Ask the agent about stock
// @name agent_stock
POST http://localhost:3005/agent/run
Content-Type: application/json

{"task": "What is the current inventory?"}

### Get the result of the previous run
@instance_id = {{agent_stock.response.body.instance_id}}
GET http://localhost:3005/agent/instances/{{instance_id}}

### Ask the agent for a forecast
POST http://localhost:3005/agent/run
Content-Type: application/json

{"task": "Forecast demand for orange over the next 10 minutes."}

### Ask the agent to reposition if needed
POST http://localhost:3005/agent/run
Content-Type: application/json

{"task": "Check every SKU and place reposition orders for anything at risk of running out before the next order could arrive."}

### Ask the agent what's in flight
POST http://localhost:3005/agent/run
Content-Type: application/json

{"task": "What reposition orders are currently in flight?"}
